	"bugs": {
		"url": "https://github.com/GinkoGio/mgi-website-dev/issues"
	},
	"homepage": "https://github.com/GinkoGio/mgi-website-dev#readme",
	"devDependencies": {
		"@11ty/eleventy": "^3.0.0"
	}
