---
layout: base.njk
pageSlug: "what-we-do"
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.urlPrefix }}/what-we-do.html"
---
{% set t = i18n[pageSlug] | localize(lang.code) %}
{% if lang.code == 'it' %}
  {% set assetBase = '../' %}
{% else %}
  {% set assetBase = '' %}
{% endif %}

<!-- PAGE HERO -->
<div class="page-hero">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="container">
    <p class="section-eyebrow light">{{ t.hero_eyebrow }}</p>
    <h1>{{ t.hero_title | safe }}</h1>
    <p>{{ t.hero_subtitle }}</p>
  </div>
</div>

<!-- INTRO -->
<section class="section-white">
  <div class="container">
    <p class="lead">{{ t.intro_p1 | safe }}</p>
    <p class="lead">{{ t.intro_p2 }}</p>
    <p class="lead">{{ t.intro_p3 }}</p>
    <p class="lead">{{ t.intro_p4 }}</p>

    <div class="sectors-grid" style="margin-top: 56px;">

      <div class="sector-card">
        <div class="sector-num">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </div>
        <div class="sector-body">
          <h3>{{ t.card1_title }}</h3>
          <p>{{ t.card1_p }}</p>
          <ul>
            <li>{{ t.card1_li1 }}</li>
            <li>{{ t.card1_li2 }}</li>
            <li>{{ t.card1_li3 }}</li>
          </ul>
        </div>
      </div>

      <div class="sector-card">
        <div class="sector-num">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.5"/><circle cx="4.5" cy="18" r="2.5"/><circle cx="19.5" cy="18" r="2.5"/><line x1="12" y1="7.5" x2="12" y2="12"/><line x1="12" y1="12" x2="4.5" y2="15.5"/><line x1="12" y1="12" x2="19.5" y2="15.5"/></svg>
        </div>
        <div class="sector-body">
          <h3>{{ t.card2_title }}</h3>
          <p>{{ t.card2_p }}</p>
          <ul>
            <li>{{ t.card2_li1 }}</li>
            <li>{{ t.card2_li2 }}</li>
            <li>{{ t.card2_li3 }}</li>
          </ul>
        </div>
      </div>

      <div class="sector-card">
        <div class="sector-num">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="1"/><path d="M16 21V7a4 4 0 0 0-8 0v14"/><line x1="9" y1="11" x2="9" y2="11.01"/><line x1="15" y1="11" x2="15" y2="11.01"/><line x1="9" y1="15" x2="9" y2="15.01"/><line x1="15" y1="15" x2="15" y2="15.01"/></svg>
        </div>
        <div class="sector-body">
          <h3>{{ t.card3_title }}</h3>
          <p>{{ t.card3_p }}</p>
          <ul>
            <li>{{ t.card3_li1 }}</li>
            <li>{{ t.card3_li2 }}</li>
            <li>{{ t.card3_li3 }}</li>
          </ul>
        </div>
      </div>

      <div class="sector-card">
        <div class="sector-num">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
        </div>
        <div class="sector-body">
          <h3>{{ t.card4_title }}</h3>
          <p>{{ t.card4_p }}</p>
          <ul>
            <li>{{ t.card4_li1 }}</li>
            <li>{{ t.card4_li2 }}</li>
            <li>{{ t.card4_li3 }}</li>
          </ul>
        </div>
      </div>

    </div>

    <div class="highlight-box" style="margin-top: 40px;">
      <p>{{ t.highlight | safe }}</p>
    </div>

    <div class="btn-actions">
      <a href="investment-sectors.html" class="btn btn-primary">{{ t.btn1 }}</a>
      <a href="portfolio.html" class="btn-outline">{{ t.btn2 }}</a>
    </div>
  </div>
</section>

<!-- ACTIVE MANAGEMENT -->
<section class="section-off">
  <div class="container">
    <div class="two-col">
      <div>
        <p class="section-eyebrow">{{ t.active_eyebrow }}</p>
        <h2 class="section-title crimson">{{ t.active_title | safe }}</h2>
        <p class="lead">{{ t.active_p1 }}</p>
        <p class="lead">{{ t.active_p2 }}</p>
      </div>
      <div class="col-image">
        <img src="{{ assetBase }}images/solar-aerial.webp" alt="Solar energy installation management" loading="lazy" />
      </div>
    </div>
  </div>
</section>

