---
layout: base.njk
pageSlug: "about"
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.urlPrefix }}/about.html"
---
{% set t = i18n[pageSlug] | localize(lang.code) %}
{% if lang.code == 'it' %}
  {% set assetBase = '../' %}
{% else %}
  {% set assetBase = '' %}
{% endif %}

<!-- PAGE HERO -->
<div class="page-hero">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-crosshair crosshair-tl" aria-hidden="true"></div>
  <div class="hero-crosshair crosshair-br" aria-hidden="true"></div>
  <div class="container">
    <p class="section-eyebrow light">{{ t.hero_eyebrow }}</p>
    <h1>{{ t.hero_title | safe }}</h1>
    <p>{{ t.hero_subtitle }}</p>
  </div>
</div>

<!-- MAIN ABOUT -->
<section class="section-white">
  <div class="container">
    <div class="two-col" style="margin-bottom: 72px;">
      <div>
        <p class="lead">{{ t.lead_p1 | safe }}</p>
        <p class="lead">{{ t.lead_p2 }}</p>
        <p class="lead">{{ t.lead_p3 }}</p>
      </div>
      <div class="col-image">
        <img src="{{ assetBase }}images/corporate-building.webp" alt="Modern corporate building" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<!-- VALUES — dark bg -->
<section class="section-dark">
  <div class="container">
    <p class="section-eyebrow light">{{ t.values_eyebrow }}</p>
    <h2 class="section-title light">{{ t.values_title | safe }}</h2>
    <div class="value-cards">
      <div class="value-card">
        <h4>{{ t.val1_title }}</h4>
        <p>{{ t.val1_body }}</p>
      </div>
      <div class="value-card">
        <h4>{{ t.val2_title }}</h4>
        <p>{{ t.val2_body }}</p>
      </div>
      <div class="value-card">
        <h4>{{ t.val3_title }}</h4>
        <p>{{ t.val3_body }}</p>
      </div>
    </div>
    <div class="btn-actions">
      <a href="philosophy.html" class="btn-outline-white">{{ t.val_btn1 }}</a>
      <a href="contact.html" class="btn-outline-white">{{ t.val_btn2 }}</a>
    </div>
  </div>
</section>

<!-- TEAM -->
<section class="section-white">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-eyebrow">{{ t.team_eyebrow }}</p>
      <h2 class="section-title crimson">{{ t.team_title }}</h2>
    </div>
    <p class="lead reveal" style="max-width:780px;margin:0 auto;text-align:center;">{{ t.team_body }}</p>
  </div>
</section>

<!-- MILAN -->
<section class="section-off">
  <div class="container">
    <div class="two-col reverse">
      <div class="col-image">
        <img src="{{ assetBase }}images/milan-skyline.webp" alt="Milan skyline" loading="lazy" />
      </div>
      <div>
        <p class="section-eyebrow">{{ t.milan_eyebrow }}</p>
        <h2 class="section-title crimson">{{ t.milan_title }}</h2>
        <p class="lead">{{ t.milan_p1 }}</p>
        <p class="lead">{{ t.milan_p2 }}</p>
        <div class="btn-actions" style="margin-top: 32px;">
          <a href="contact.html" class="btn btn-primary">{{ t.milan_btn }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

