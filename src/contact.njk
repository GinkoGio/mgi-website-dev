---
layout: base.njk
pageSlug: "contact"
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.urlPrefix }}/contact.html"
---
{% set t = i18n[pageSlug] | localize(lang.code) %}
{% if lang.code == 'it' %}
  {% set assetBase = '../' %}
{% else %}
  {% set assetBase = '' %}
{% endif %}

{% block footer_disclaimer %}{{ t.footer_disclaimer }}{% endblock %}

<!-- PAGE HERO -->
<div class="page-hero">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="container">
    <p class="section-eyebrow light">{{ t.hero_eyebrow }}</p>
    <h1>{{ t.hero_title }}</h1>
    <p>{{ t.hero_subtitle }}</p>
  </div>
</div>

<!-- CONTACT SECTION -->
<section class="section-white">
  <div class="container">
    <div class="two-col">
      <div>
        <p class="lead">{{ t.intro_p }}</p>

        <div class="contact-cards">
          <div class="contact-card">
            <div class="contact-card-head">
              <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {{ t.hq_label }}
            </div>
            <p>{{ t.hq_line1 }}</p>
            <p>{{ t.hq_line2 }}</p>
          </div>
          <div class="contact-card">
            <div class="contact-card-head">
              <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              {{ t.email_label }}
            </div>
            <a href="mailto:info@maverickglob.com">info@maverickglob.com</a>
            <a href="mailto:mavkglob@pec.it">mavkglob@pec.it</a>
          </div>
          <div class="contact-card">
            <div class="contact-card-head">
              <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.61 4.4 2 2 0 0 1 3.58 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {{ t.phone_label }}
            </div>
            <p>{{ t.phone_num }}</p>
            <p style="color:var(--text-2); font-size:13px;">{{ t.phone_hours }}</p>
          </div>
        </div>

        <div class="btn-actions">
          <a href="#contact-form" class="btn btn-primary">{{ t.btn_write }}</a>
        </div>
      </div>

      <div class="col-image">
        <img src="{{ assetBase }}images/milan-skyline.webp" alt="Milan Duomo" loading="lazy" />
      </div>
    </div>

    <!-- CONTACT FORM -->
    <div id="contact-form" class="contact-form-wrap">
      <p class="section-eyebrow">{{ t.form_eyebrow }}</p>
      <h2 class="section-title crimson" style="font-size:28px; margin-bottom: 8px;">{{ t.form_title }}</h2>
      <p style="font-size:14px; color:var(--text-2); margin-bottom: 32px;">{{ t.form_helper }}</p>
      <form onsubmit="handleSubmit(event)">
        <input type="hidden" name="access_key" value="b8a62092-f65a-4d65-a8aa-7c4ad4a4a04e">
        <input type="hidden" name="from_name" value="Maverick Global Investments — Website">
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="form-grid">
          <div class="form-field">
            <label for="name">{{ t.form_label_name }}</label>
            <input type="text" id="name" name="name" placeholder="{{ t.form_ph_name }}" required>
          </div>
          <div class="form-field">
            <label for="company">{{ t.form_label_co }}</label>
            <input type="text" id="company" name="company" placeholder="{{ t.form_ph_co }}">
          </div>
          <div class="form-field">
            <label for="email">{{ t.form_label_email }}</label>
            <input type="email" id="email" name="email" placeholder="{{ t.form_ph_email }}" required>
          </div>
          <div class="form-field">
            <label for="type">{{ t.form_label_type }}</label>
            <select id="type" name="type">
              <option value="">{{ t.form_select_default }}</option>
              <option value="investor">{{ t.form_opt_investor }}</option>
              <option value="developer">{{ t.form_opt_developer }}</option>
              <option value="operator">{{ t.form_opt_operator }}</option>
              <option value="partner">{{ t.form_opt_partner }}</option>
              <option value="other">{{ t.form_opt_other }}</option>
            </select>
          </div>
          <div class="form-field full">
            <label for="subject">{{ t.form_label_subject }}</label>
            <input type="text" id="subject" name="subject" placeholder="{{ t.form_ph_subject }}">
          </div>
          <div class="form-field full">
            <label for="message">{{ t.form_label_message }}</label>
            <textarea id="message" name="message" placeholder="{{ t.form_ph_message }}" required></textarea>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">{{ t.form_submit }}</button>
        <p class="form-result" id="form-result" role="status" aria-live="polite" style="display:none; margin-top:16px; font-size:14px;"></p>
        <p class="form-note">{{ t.form_note }}</p>
      </form>
    </div>
  </div>
</section>

{% block scripts %}
<script>
async function handleSubmit(e) {
  e.preventDefault();
  const f = e.target;
  const btn = f.querySelector('button[type=submit]');
  const result = document.getElementById('form-result');

  if (!f.subject.value.trim()) {
    f.subject.value = '{{ t.form_subject_default }}';
  }

  btn.textContent = '{{ t.form_submit_opening }}';
  btn.disabled = true;
  result.style.display = 'none';

  try {
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: new FormData(f)
    });
    const data = await res.json();
    if (res.ok && data.success) {
      result.textContent = '{{ t.form_success }}';
      result.style.color = 'var(--amber)';
      result.style.display = 'block';
      f.reset();
    } else {
      throw new Error(data.message || 'submit failed');
    }
  } catch (err) {
    result.textContent = '{{ t.form_error }}';
    result.style.color = 'var(--rose)';
    result.style.display = 'block';
  } finally {
    btn.textContent = '{{ t.form_submit }}';
    btn.disabled = false;
  }
}
</script>
{% endblock %}


