---
layout: base.njk
pageSlug: "index"
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.urlPrefix }}/index.html"
---
{% set t = i18n[pageSlug] | localize(lang.code) %}
{% if lang.code == 'it' %}
  {% set assetBase = '../' %}
{% else %}
  {% set assetBase = '' %}
{% endif %}

<!-- ═══════════════════════════════════ HERO ═══════ -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <canvas id="hero-canvas" aria-hidden="true"></canvas>
      <div class="hero-left">
        <div class="hero-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          {{ t.badge }}
        </div>
        <div class="hero-brand">
          <img src="{{ assetBase }}images/logo.webp" alt="" class="hero-logo" aria-hidden="true">
          <div class="hero-wordmark">
            <span class="hw-main">Maverick</span>
            <span class="hw-sub">Global Investments</span>
          </div>
        </div>
        <h1 class="hero-title">{{ t.hero_title | safe }}</h1>
        <p class="hero-subtitle">{{ t.hero_subtitle }}</p>
        <p class="hero-body">{{ t.hero_body }}</p>
        <div class="hero-actions">
          <a href="{{ t.hero_btn1_href }}" class="btn btn-primary">{{ t.hero_btn1 }}</a>
          <a href="philosophy.html" class="btn btn-ghost">{{ t.hero_btn2 }}</a>
        </div>
      </div><!-- /hero-left -->

      <div class="hero-right">
        <div class="hero-wireframe" aria-hidden="true">
          <img src="{{ assetBase }}images/solar-wireframe.webp" alt="">
        </div>
        <div class="hero-metrics">
          <div class="hero-metric">
            <div class="metric-num" data-target="70000">{{ t.metric1_display }}</div>
            <div class="metric-label">{{ t.metric1_label }}</div>
            <div class="metric-desc">{{ t.metric1_desc }}</div>
          </div>
          <div class="hero-metric">
            <div class="metric-num" data-target="26000">{{ t.metric2_display }}</div>
            <div class="metric-label">{{ t.metric2_label }}</div>
            <div class="metric-desc">{{ t.metric2_desc }}</div>
          </div>
          <div class="hero-metric">
            <div class="metric-num" data-target="21000">{{ t.metric3_display }}</div>
            <div class="metric-label">{{ t.metric3_label }}</div>
            <div class="metric-desc">{{ t.metric3_desc }}</div>
          </div>
        </div>
      </div><!-- /hero-right -->
    </div><!-- /hero-content -->
  </div><!-- /hero-inner -->
  <div class="hero-crosshair crosshair-tl" aria-hidden="true"></div>
  <div class="hero-crosshair crosshair-br" aria-hidden="true"></div>
</section>


<!-- ═════════════════════════════ INVESTMENT SECTORS ═══ -->
<section class="sectors-section">
  <div class="container">
    <div class="section-header reveal">
      <div class="eyebrow">{{ t.sectors_eyebrow }}</div>
      <h2 class="section-title">{{ t.sectors_title }}</h2>
    </div>
    <div class="sectors-grid">

      <div class="sector-card reveal">
        <div class="card-shine" aria-hidden="true"></div>
        <div class="sector-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <h3>{{ t.sector1_title }}</h3>
        <p>{{ t.sector1_desc }}</p>
        <a href="investment-sectors.html" class="card-link">{{ t.explore_link }} <span>→</span></a>
      </div>

      <div class="sector-card reveal reveal-delay-1">
        <div class="card-shine" aria-hidden="true"></div>
        <div class="sector-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <path d="M3 9h18M9 21V9"/>
          </svg>
        </div>
        <h3>{{ t.sector2_title }}</h3>
        <p>{{ t.sector2_desc }}</p>
        <a href="investment-sectors.html" class="card-link">{{ t.explore_link }} <span>→</span></a>
      </div>

      <div class="sector-card reveal reveal-delay-2">
        <div class="card-shine" aria-hidden="true"></div>
        <div class="sector-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <h3>{{ t.sector3_title }}</h3>
        <p>{{ t.sector3_desc }}</p>
        <a href="investment-sectors.html" class="card-link">{{ t.explore_link }} <span>→</span></a>
      </div>

    </div><!-- /sectors-grid -->
  </div>
</section>


<!-- ══════════════════════════════ DIFFERENTIATORS ═══ -->
<section class="diff-section">
  <div class="container">
    <div class="section-header reveal">
      <div class="eyebrow">{{ t.diff_eyebrow }}</div>
      <h2 class="section-title">{{ t.diff_title | safe }}</h2>
    </div>
    <div class="diff-grid">
      <div class="diff-card reveal">
        <div class="diff-num">01</div>
        <h3>{{ t.diff1_title }}</h3>
        <p>{{ t.diff1_body }}</p>
      </div>
      <div class="diff-card reveal reveal-delay-1">
        <div class="diff-num">02</div>
        <h3>{{ t.diff2_title }}</h3>
        <p>{{ t.diff2_body }}</p>
      </div>
      <div class="diff-card reveal reveal-delay-2">
        <div class="diff-num">03</div>
        <h3>{{ t.diff3_title }}</h3>
        <p>{{ t.diff3_body }}</p>
      </div>
    </div>
  </div>
</section>


<!-- ══════════════════════════════════ CTA BANNER ═══ -->
<section class="cta-banner">
  <div class="container">
    <div class="cta-banner-inner reveal">
      <div class="cta-banner-text">
        <h2>{{ t.cta_title }}</h2>
        <p>{{ t.cta_body }}</p>
      </div>
      <div class="cta-banner-actions">
        <a href="contact.html"   class="btn btn-primary">{{ t.cta_btn1 }}</a>
        <a href="portfolio.html" class="btn btn-ghost">{{ t.cta_btn2 }}</a>
      </div>
    </div>
  </div>
</section>

