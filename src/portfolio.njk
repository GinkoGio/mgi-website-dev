{% block scripts %}
<script>
(function () {
  var track = document.querySelector('.slider-track');
  if (!track) return;
  var BASE = 0.6;
  var x = 0;
  var hovPaused = false;
  var manPaused = false;

  function half() { return track.scrollWidth / 2; }

  function tick() {
    if (!hovPaused && !manPaused) {
      x -= BASE;
      var h = half();
      if (-x >= h) x += h;
      if (x > 0) x -= h;
      track.style.transform = 'translateX(' + x + 'px)';
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);

  var vp = document.querySelector('.slider-viewport');
  if (vp) {
    vp.addEventListener('mouseenter', function () { hovPaused = true; });
    vp.addEventListener('mouseleave', function () { hovPaused = false; });
  }

  var btn = document.getElementById('sliderToggle');
  if (btn) {
    btn.addEventListener('click', function () {
      manPaused = !manPaused;
      btn.textContent = manPaused ? '▶ PLAY' : '⏸ PAUSE';
    });
  }
})();

(function () {
  var tabs = document.querySelectorAll('.map-tab');
  var gallery = document.querySelector('.gallery-slider');
  var mapPanel = document.getElementById('mapPanel');
  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      tabs.forEach(function (t) { t.classList.remove('active'); });
      btn.classList.add('active');
      if (btn.dataset.tab === 'map') {
        gallery.style.display = 'none';
        mapPanel.style.display = 'block';
      } else {
        gallery.style.display = '';
        mapPanel.style.display = 'none';
      }
    });
  });
})();
</script>
{% endblock %}

