    <div class="two-col top" style="margin-bottom: 64px;">
      <div>
        <p class="lead">{{ t.intro_p1 | safe }}</p>
        <p class="lead">{{ t.intro_p2 }}</p>
        <p class="lead">{{ t.intro_p3 }}</p>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div style="background:var(--bg-3);border:1px solid var(--rose-border);border-radius:10px;padding:28px;">
          <div style="font-family:'Space Grotesk',sans-serif;font-size:38px;color:var(--stat-num-color, var(--rose));line-height:1;">{{ t.stat1_num }}</div>
          <div style="font-size:13px;font-weight:700;margin-top:8px;color:var(--text-1);">{{ t.stat1_label }}</div>
          <div style="font-size:12px;color:var(--text-2);margin-top:4px;">{{ t.stat1_sub }}</div>
        </div>
        <div style="background:var(--bg-3);border:1px solid var(--rose-border);border-radius:10px;padding:28px;">
          <div style="font-family:'Space Grotesk',sans-serif;font-size:38px;color:var(--stat-num-color, var(--rose));line-height:1;">{{ t.stat2_num }}</div>
          <div style="font-size:13px;font-weight:700;margin-top:8px;color:var(--text-1);">{{ t.stat2_label }}</div>
          <div style="font-size:12px;color:var(--text-2);margin-top:4px;">{{ t.stat2_sub }}</div>
        </div>
        <div style="background:var(--bg-3);border:1px solid var(--rose-border);border-radius:10px;padding:28px;">
          <div style="font-family:'Space Grotesk',sans-serif;font-size:38px;color:var(--stat-num-color, var(--rose));line-height:1;">{{ t.stat3_num }}</div>
          <div style="font-size:13px;font-weight:700;margin-top:8px;color:var(--text-1);">{{ t.stat3_label }}</div>
